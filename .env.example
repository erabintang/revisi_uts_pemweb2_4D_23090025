# ─────────────────────────────────────────────────────────────
# mangkrak.io — Laravel 12 (.env.example)
# 100% SUPABASE (PostgreSQL). Salin ke .env lalu isi kredensial.
# ⚠️ File ini ikut ter-commit — JANGAN isi nilai asli di sini.
#    Kredensial asli hanya di .env (ter-ignore git) / env Vercel.
# ─────────────────────────────────────────────────────────────

APP_NAME="mangkrak.io"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://nama-proyek-mu.vercel.app

# Sesi di cookie — aman untuk serverless (Vercel) + Supabase
SESSION_DRIVER=cookie
SESSION_LIFETIME=120

# Cache & queue sederhana (tanpa Redis)
CACHE_STORE=array
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# ─────────────────────────────────────────────────────────────
# DATABASE — SUPABASE (PostgreSQL) — WAJIB DIISI DI .env / VERCEL
#
# Cara ambil kredensial:
#   Dashboard Supabase → Project Settings → Database → Connection string
#   pilih tab "Pooler" → Reveal (untuk melihat password asli)
#
# ⚠️ DB_PASSWORD = password DATABASE (tombol Reveal) — BUKAN publishable key!
# ⚠️ Ganti <REF_PROJECT> dengan ref proyekmu (subdomain .supabase.co).
# ─────────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=aws-1-ap-northeast-2.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.<REF_PROJECT>
DB_PASSWORD=
DB_SSLMODE=require

# ── ALTERNATIF TERMUDAH (opsional) ─────────────────────────
# Tempel URI lengkap dari Supabase → Project Settings → Database → Connection string
# (tab Pooler, port 5432, klik Reveal). Jika DB_URL diisi, nilainya menimpa
# DB_HOST / DB_PORT / DB_DATABASE / DB_USERNAME / DB_PASSWORD di atas.
# DB_URL=postgresql://postgres.<REF_PROJECT>:<PASSWORD>@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres

# ─────────────────────────────────────────────────────────────
# SUPABASE CLIENT (opsional — untuk fitur frontend)
# ─────────────────────────────────────────────────────────────
PUBLIC_SUPABASE_URL=https://<REF_PROJECT>.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────
# LAINNYA (opsional)
# ─────────────────────────────────────────────────────────────
MAIL_MAILER=log
FILESYSTEM_DISK=local
